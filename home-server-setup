#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVER_DIR="/srv/home-server"
HELLO_DIR="$SERVER_DIR/hello"
CADDYFILE="/etc/caddy/Caddyfile"

# --- Prompt for domain ---

read -rp "Enter your server domain name (e.g. example.com): " DOMAIN

if [[ -z "$DOMAIN" ]]; then
  echo "Error: domain name cannot be empty." >&2
  exit 1
fi

echo ""
echo "Setting up home-server for: $DOMAIN"
echo "  - hello.$DOMAIN -> static HTML"
echo ""

# --- Create directories ---

sudo mkdir -p "$HELLO_DIR"

# --- Hello World static site ---

sudo cp "$SCRIPT_DIR/index.html" "$HELLO_DIR/index.html"
echo "Installed $HELLO_DIR/index.html"

# --- Caddyfile ---

sudo cp "$CADDYFILE" "$CADDYFILE.bak" 2>/dev/null || true

sed "s/{{DOMAIN}}/$DOMAIN/g" "$SCRIPT_DIR/Caddyfile.template" | sudo tee "$CADDYFILE" > /dev/null
echo "Installed $CADDYFILE"

# --- Enable and start services ---

sudo systemctl daemon-reload

sudo systemctl enable --now sshd
echo "Enabled sshd"

sudo systemctl enable --now docker
echo "Enabled docker"

sudo systemctl enable --now caddy
echo "Enabled caddy"

# --- Cloudflare DDNS ---

CF_CONFIG="/etc/home-server/cloudflare-ddns.conf"

if [[ -f "$CF_CONFIG" ]]; then
  echo "$CF_CONFIG already exists; leaving DDNS config untouched."
else
  read -rsp "Cloudflare API token (leave blank to skip DDNS): " CF_API_TOKEN
  echo ""
  if [[ -n "$CF_API_TOKEN" ]]; then
    read -rp "Cloudflare Zone ID for $DOMAIN: " CF_ZONE_ID
    read -rp "DNS records to keep updated (comma-separated) [hello.$DOMAIN]: " CF_RECORDS
    CF_RECORDS="${CF_RECORDS:-hello.$DOMAIN}"

    sudo install -d -m 755 /etc/home-server
    sudo install -m 600 /dev/null "$CF_CONFIG"
    sudo tee "$CF_CONFIG" > /dev/null <<EOF
CF_API_TOKEN=$CF_API_TOKEN
CF_ZONE_ID=$CF_ZONE_ID
CF_RECORDS=$CF_RECORDS
EOF
    echo "Installed $CF_CONFIG"
  else
    echo "Skipped Cloudflare DDNS config."
  fi
fi

if [[ -f "$CF_CONFIG" ]]; then
  sudo systemctl enable --now cloudflare-ddns.timer
  echo "Enabled cloudflare-ddns.timer (runs every 5 min)"
fi

echo ""
echo "Done! Make sure DNS for hello.$DOMAIN points to this server."
echo "Caddy will automatically obtain TLS certificates via Let's Encrypt."
