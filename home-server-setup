#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Where shared templates/assets live after install. Fall back to the script
# directory when running from a checkout.
if [[ -f /usr/share/home-server/Caddyfile.template ]]; then
  ASSETS_DIR=/usr/share/home-server
else
  ASSETS_DIR="$SCRIPT_DIR"
fi
SERVER_DIR="/srv/home-server"
SITE_DIR="$SERVER_DIR/site"
APPS_DIR="$SERVER_DIR/apps"
CADDY_APPS_DIR="/etc/caddy/apps"
CADDYFILE="/etc/caddy/Caddyfile"
CONFIG_DIR="/etc/home-server"

# --- Prompt for domain ---

read -rp "Enter your server domain name (e.g. m4s.dev): " DOMAIN

if [[ -z "$DOMAIN" ]]; then
  echo "Error: domain name cannot be empty." >&2
  exit 1
fi

echo ""
echo "Setting up home-server for: $DOMAIN"
echo "  - $DOMAIN, www.$DOMAIN -> static site at $SITE_DIR"
echo "  - <app>.$DOMAIN        -> docker app, see $APPS_DIR and $CADDY_APPS_DIR"
echo ""

# --- Persist server config ---

sudo install -d -m 755 "$CONFIG_DIR"
echo "DOMAIN=$DOMAIN" | sudo tee "$CONFIG_DIR/config" >/dev/null
echo "Installed $CONFIG_DIR/config"

# --- Create directories ---

sudo install -d -m 755 "$SITE_DIR" "$APPS_DIR" "$CADDY_APPS_DIR"

# --- Static site ---

sudo cp "$ASSETS_DIR/index.html" "$SITE_DIR/index.html"
echo "Installed $SITE_DIR/index.html"

# --- Caddyfile ---

sudo cp "$CADDYFILE" "$CADDYFILE.bak" 2>/dev/null || true

sed "s/{{DOMAIN}}/$DOMAIN/g" "$ASSETS_DIR/Caddyfile.template" | sudo tee "$CADDYFILE" > /dev/null
echo "Installed $CADDYFILE"

# --- Enable and start services ---

sudo systemctl daemon-reload

sudo systemctl enable --now sshd
echo "Enabled sshd"

sudo systemctl enable --now docker
echo "Enabled docker"

sudo systemctl enable --now caddy
echo "Enabled caddy"

# --- Cloudflare DDNS ---

CF_CONFIG="$CONFIG_DIR/cloudflare-ddns.conf"

if [[ -f "$CF_CONFIG" ]]; then
  echo "$CF_CONFIG already exists; leaving DDNS config untouched."
else
  read -rsp "Cloudflare API token (leave blank to skip DDNS): " CF_API_TOKEN
  echo ""
  if [[ -n "$CF_API_TOKEN" ]]; then
    read -rp "Cloudflare Zone ID for $DOMAIN: " CF_ZONE_ID
    read -rp "DNS records to keep updated (comma-separated) [$DOMAIN,www.$DOMAIN]: " CF_RECORDS
    CF_RECORDS="${CF_RECORDS:-$DOMAIN,www.$DOMAIN}"

    sudo install -m 600 /dev/null "$CF_CONFIG"
    sudo tee "$CF_CONFIG" > /dev/null <<EOF
CF_API_TOKEN=$CF_API_TOKEN
CF_ZONE_ID=$CF_ZONE_ID
CF_RECORDS=$CF_RECORDS
EOF
    echo "Installed $CF_CONFIG"
  else
    echo "Skipped Cloudflare DDNS config."
  fi
fi

if [[ -f "$CF_CONFIG" ]]; then
  sudo systemctl enable --now cloudflare-ddns.timer
  echo "Enabled cloudflare-ddns.timer (runs every 5 min)"
fi

echo ""
echo "Done!"
echo "  - Point DNS for $DOMAIN and www.$DOMAIN at this server's public IP."
echo "  - Add a docker app with: home-server-add-app <name> <port>"
echo "  - Optionally install NanoClaw with: home-server-nanoclaw"
echo "  - Caddy will obtain TLS certificates via Let's Encrypt automatically."
